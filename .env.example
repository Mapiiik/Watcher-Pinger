# The server of Watcher Pinger, read by compose.production.yaml. Only PINGER_AUTH has no default.

export PINGER_LISTEN_HTTP="0.0.0.0:80"
# empty serves the page on PINGER_LISTEN_HTTP alone, for TLS ended by a proxy in front
export PINGER_LISTEN_HTTPS="0.0.0.0:443"
# the name of the server: its certificate from Let's Encrypt (TLS-ALPN on 443) and the only name it answers;
# empty for a self-signed certificate and any name
export PINGER_HOSTNAME="pinger.example.com"
export PINGER_CERT_DIR="/app/certs"
# behind HAProxy and the like passing TLS through, from these networks only, which are then required
export PINGER_USE_PROXY_PROTOCOL="false"
export PINGER_PROXY_ALLOW_CIDRS=""

# who may see the page: oidc, header or none
export PINGER_AUTH="oidc"
export PINGER_OIDC_ISSUER="https://login.example.com/application/o/watcher-pinger/"
export PINGER_OIDC_CLIENT_ID=""
export PINGER_OIDC_CLIENT_SECRET=""
# https://PINGER_HOSTNAME/auth/callback unless set
export PINGER_OIDC_REDIRECT_URL=""
# members of any of these groups only, empty for whoever the provider lets through
export PINGER_OIDC_GROUPS=""
# signs the session cookies, at least 32 bytes (openssl rand -base64 48); empty for a key of its own every start,
# which signs everyone in again quietly
export PINGER_SESSION_KEY=""
export PINGER_SESSION_TTL="12h"
# PINGER_AUTH=header: the user from this header, set by these proxies only
export PINGER_AUTH_HEADER="X-Authentik-Username"
export PINGER_AUTH_PROXY_CIDRS=""

# the network from Watcher NMS over https, with the key of a user of the role watcher-pinger; empty for PINGER_DATA alone
export PINGER_WATCHER_NMS_URL="https://nms.example.com"
export PINGER_WATCHER_NMS_TOKEN=""
export PINGER_WATCHER_NMS_INTERVAL="1h"
# the network itself without Watcher NMS, otherwise the copy of the last one fetched
export PINGER_DATA="/app/data/watcher-pinger.json"

# the ICMP socket: auto takes an unprivileged one where net.ipv4.ping_group_range allows it, as Docker does, and a raw
# one otherwise, which needs NET_RAW
export PINGER_ICMP="auto"

# how patiently and how often: what a page shows, the devices of the network, the customers
export PINGER_TIMEOUT="1s"
export PINGER_WATCHED_INTERVAL="5s"
export PINGER_DEVICE_INTERVAL="30s"
export PINGER_IDLE_INTERVAL="1m"
export PINGER_WORKERS="512"
