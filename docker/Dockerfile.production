# The server of Watcher Pinger. The program for Windows is built by the CI on its own.

# ---------- build ----------
ARG GO_VERSION="1.27"
FROM --platform=${BUILDPLATFORM:-linux/amd64} golang:${GO_VERSION}-alpine AS build

ARG TARGETOS
ARG TARGETARCH
ARG VERSION="dev"

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/watcher-pinger-server ./src/server \
    && mkdir -p /out/certs /out/data

# ---------- runtime ----------
# Nothing runs in this stage (Alpine ships the CA bundle), so other platforms need no emulation. The folders for
# the certificates and for the last network fetched come from the build stage for that reason, owned by the user the
# server runs as, which needs no entry in /etc/passwd. It pings over an unprivileged ICMP socket and binds 80 and 443
# where the container allows it, see compose.production.yaml.
FROM alpine:latest

WORKDIR /app

COPY --from=build /out/watcher-pinger-server /app/
COPY --from=build --chown=1000:1000 /out/certs /app/certs
COPY --from=build --chown=1000:1000 /out/data /app/data

USER 1000:1000

EXPOSE 80 443

ENTRYPOINT ["/app/watcher-pinger-server"]
